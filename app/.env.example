# OncoAgent environment. Copy to .env.local for local work; set the same keys in Vercel → Settings → Environment Variables.
# Never commit real values.

# ---- Sign-in (required unless AUTH_MODE=off) ----
# 32+ random characters. Generate: npm run hash-password -- "<password>" --secret
AUTH_SECRET=
# One account:
AUTH_USERNAME=
# scrypt hash from: npm run hash-password -- "<password>"
# In .env files escape every $ as \$ (Next.js expands $VARS); in the Vercel dashboard paste it as is.
AUTH_PASSWORD_HASH=
AUTH_DISPLAY_NAME=
AUTH_ROLE=clinician
# Or several accounts as JSON (overrides nothing; both sources are merged):
# AUTH_USERS=[{"username":"dr.rahman","passwordHash":"scrypt$...","name":"Dr. Rahman","role":"clinician"}]
# AUTH_MODE=off   # local experiments only: disables sign-in, every request acts as "Dr. Demo"

# ---- Storage (optional) ----
# Unset: cases, runs and the audit log stay in each clinician's browser.
# Set to any PostgreSQL 13+ (Neon, Supabase, RDS, self-hosted) to keep them on the server per account.
# The tables are created on first use, or run: npm run db:migrate. Redeploy after setting it.
# DATABASE_URL=postgres://user:password@host:5432/oncoagent
# DATABASE_SSL=disable      # only for a local database without TLS
# DATABASE_POOL_MAX=5
# Local development without PostgreSQL: DATABASE_URL=pglite:./.data/pg  (embedded, not for serverless)

# ---- Claude synthesis (optional; rules-only agents run without it) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- MCP endpoint (optional) ----
# Bearer token for external MCP clients at /api/mcp. Signed-in users can always use the in-app tester.
# MCP_BEARER_TOKEN=
